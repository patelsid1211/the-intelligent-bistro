# ─────────────────────────────────────────────────────────────
# The Intelligent Bistro — .gitignore
# ─────────────────────────────────────────────────────────────

# ── Dependencies ──────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# ── Environment / Secrets (NEVER commit these) ────────────────
.env
.env.local
.env.development
.env.production
.env.staging
.env*.local
api-server/.env
api-server/.env.local
api-server/.env.production

# ── Database files (auto-generated, not source) ───────────────
api-server/bistro.db
api-server/bistro.db-shm
api-server/bistro.db-wal
*.db
*.sqlite
*.sqlite3

# ── Build output ──────────────────────────────────────────────
dist/
build/
out/
api-server/dist/
web-build/
.next/
.nuxt/

# ── Expo ──────────────────────────────────────────────────────
.expo/
expo-env.d.ts
*.orig.*

# ── React Native / Native builds ──────────────────────────────
/ios/
/android/
.kotlin/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.keystore

# ── TypeScript ────────────────────────────────────────────────
*.tsbuildinfo
*.d.ts.map

# ── Logs ──────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── OS generated ──────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Editor / IDE ──────────────────────────────────────────────
.vscode/settings.json
.vscode/launch.json
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ── Metro bundler ─────────────────────────────────────────────
.metro-health-check*
.metro/

# ── Testing ───────────────────────────────────────────────────
coverage/
.nyc_output/
*.lcov

# ── Misc ──────────────────────────────────────────────────────
*.pem
*.cert
.cache/
.temp/
.tmp/
tmp/
temp/
