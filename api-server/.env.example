# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# OpenAI API key — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-key-here

# Google Gemini API key — https://aistudio.google.com/app/apikey
# Free tier available. Used as fallback when OpenAI is unavailable.
GEMINI_API_KEY=your-gemini-api-key-here

# AI provider preference: "openai" | "gemini" | "auto" (default)
# "auto" tries OpenAI first, then Gemini, then local mock
AI_PROVIDER=auto

# Server config
PORT=3001
NODE_ENV=development

# Allowed mobile app origin (Expo dev server)
CORS_ORIGIN=http://localhost:8081
